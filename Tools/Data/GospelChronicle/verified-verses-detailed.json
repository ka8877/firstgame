  {
    "id": "luk.3.21",
    "reference": "누가복음 3:21",
    "text": "백성이 다 세례를 받을쌔 예수도 세례를 받으시고 기도하실 때에 하늘이 열리며",
    "sourceUrl": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=luk&chap=3",
    "sourceFile": "luke-3-HAN.html",
