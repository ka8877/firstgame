[
  {
    "id": "luk.2.39",
    "reference": "누가복음 2:39",
    "text": "주의 율법을 좇아 모든 일을 필하고 갈릴리로 돌아가 본 동네 나사렛에 이르니라",
    "sourceUrl": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=luk&chap=2",
