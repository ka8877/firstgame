    "sourceType": "fresh-official-response"
  },
  {
    "id": "luk.3.2",
    "reference": "누가복음 3:2",
    "text": "안나스와 가야바가 대제사장으로 있을 때에 하나님의 말씀이 빈 들에서 사가랴의 아들 요한에게 임한지라",
    "sourceUrl": "https://www.bskorea.or.kr/bible/korbibReadpage.php?version=HAN&book=luk&chap=3",
    "sourceFile": "luke-3-HAN.html",
