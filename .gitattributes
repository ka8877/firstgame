* text=auto
# Preserve upstream CC0 license/readme bytes, including their original line endings.
Tools/Art/Gospel3D/Source/*.txt -text -whitespace
*.cs text eol=lf
*.ink text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
# Source art and textures use Git LFS. Install git-lfs before cloning/pushing.
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
Games/PathOfDawn/Assets/Resources/Art/Painted/traveler-motion.bytes filter=lfs diff=lfs merge=lfs -text
# Retain fetched reference pages/scripts/text byte-for-byte with their source hashes.
Tools/Research/FmRenewal/* -text -whitespace
# Small generated delivery derivatives: one ordinary Git pack avoids 15,350
# separate LFS uploads. Exact source images and all other art retain LFS above.
Games/FantasyCards/Assets/StreamingAssets/Cards/*.jpg -filter -diff -merge -text
# Unity regenerated six empty-field trailing spaces in the verified TMP caches.
# Preserve those generated YAML bytes; source fonts/metas and other checks stay strict.
Games/FantasyCards/Assets/Resources/Fonts/Display.asset -whitespace
Games/FantasyCards/Assets/Resources/Fonts/Korean.asset -whitespace

# Retain fetched Quest research bytes and verified Unity serialized empty fields.
Tools/Research/Quest/* -text -whitespace
